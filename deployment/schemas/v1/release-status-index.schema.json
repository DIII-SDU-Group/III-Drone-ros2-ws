{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iii-drone.invalid/schemas/v1/release-status-index.schema.json",
  "title": "III append-only signed release-status index snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "index_type", "index_id", "sequence", "generated_at", "statements", "signer_id", "signature_algorithm", "signature"],
  "properties": {
    "schema_version": {"const": "1"},
    "index_type": {"const": "iii.release-status-index"},
    "index_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "statements": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "signer_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "signature_algorithm": {"const": "Ed25519"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
  }
}
