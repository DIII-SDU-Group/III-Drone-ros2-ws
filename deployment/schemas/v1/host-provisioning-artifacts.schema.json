{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iii-drone.local/schemas/v1/host-provisioning-artifacts.schema.json",
  "title": "III host provisioning artifact record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "record_id",
    "operation_id",
    "recorded_at",
    "target",
    "operator_cidr",
    "enrollment_id",
    "maintenance_ssh_client_id",
    "receiver_id",
    "signer_ids",
    "wheels",
    "inputs_sha256",
    "inventory_sha256"
  ],
  "properties": {
    "schema": {"const": "iii.host-provisioning-artifacts/v1"},
    "record_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "operation_id": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "target": {"type": "string", "minLength": 1},
    "operator_cidr": {"type": "string", "minLength": 1},
    "enrollment_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "maintenance_ssh_client_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "receiver_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "signer_ids": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle", "release_status", "receiver_update"],
      "properties": {
        "bundle": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "release_status": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "receiver_update": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "wheels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["filename", "sha256", "size"],
        "properties": {
          "filename": {"type": "string", "pattern": "^[^/]+\\.whl$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size": {"type": "integer", "minimum": 1}
        }
      }
    },
    "inputs_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "inventory_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
