{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iii-drone.invalid/schemas/v1/qualification-check.schema.json",
  "title": "III isolated qualified-release check record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "check_type", "check_id", "source_commit", "version", "outcome", "started_at", "finished_at", "command", "log_sha256", "outputs"],
  "properties": {
    "schema_version": {"const": "1"},
    "check_type": {"const": "iii.qualification-check"},
    "check_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "version": {"type": "string", "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"},
    "outcome": {"const": "passed"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "log_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256", "bytes"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
