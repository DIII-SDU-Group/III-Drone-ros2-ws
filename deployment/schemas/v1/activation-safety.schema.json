{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iii-drone.invalid/schemas/v1/activation-safety.schema.json",
  "title": "Canonical runtime activation safety observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "logical_target", "profile", "observation_id", "runtime_api_available", "runtime_identity_matches", "runtime_fresh", "px4_available", "px4_fresh", "armed", "in_air", "nav_state", "failsafe", "mission_fresh", "mission_active", "mission_control_owner", "operation_fresh", "custom_operation_active", "custom_operation_control_owner", "direct_operation_active", "reference_owner_active", "configuration_migration_ready", "configuration_checkpoint_id", "continuously_safe_for_s"],
  "properties": {
    "schema": {"const": "iii.activation-safety/v1"},
    "logical_target": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$"},
    "profile": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
    "observation_id": {"$ref": "#/definitions/hash"},
    "runtime_api_available": {"type": "boolean"},
    "runtime_identity_matches": {"type": "boolean"},
    "runtime_fresh": {"type": "boolean"},
    "px4_available": {"type": "boolean"},
    "px4_fresh": {"type": "boolean"},
    "armed": {"type": ["boolean", "null"]},
    "in_air": {"type": ["boolean", "null"]},
    "nav_state": {"type": ["string", "null"]},
    "failsafe": {"type": ["boolean", "null"]},
    "mission_fresh": {"type": "boolean"},
    "mission_active": {"type": ["boolean", "null"]},
    "mission_control_owner": {"type": ["boolean", "null"]},
    "operation_fresh": {"type": "boolean"},
    "custom_operation_active": {"type": ["boolean", "null"]},
    "custom_operation_control_owner": {"type": ["boolean", "null"]},
    "direct_operation_active": {"type": ["boolean", "null"]},
    "reference_owner_active": {"type": ["boolean", "null"]},
    "configuration_migration_ready": {"type": "boolean"},
    "configuration_checkpoint_id": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/hash"}]},
    "continuously_safe_for_s": {"type": "number", "minimum": 0}
  },
  "definitions": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
