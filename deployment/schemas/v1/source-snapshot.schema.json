{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iii-drone.invalid/schemas/v1/source-snapshot.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "content_identity", "policy_sha256", "workspace_commit", "branch", "clean", "dependency_lock_sha256", "repositories", "excluded", "changed_paths", "impact"],
  "properties": {
    "schema": {"const": "iii.source-snapshot/v1"},
    "content_identity": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "workspace_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "branch": {"type": "string", "minLength": 1},
    "clean": {"type": "boolean"},
    "dependency_lock_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "repositories": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/repository"}},
    "excluded": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "reason"], "properties": {"path": {"type": "string"}, "reason": {"enum": ["ignored", "sensitive", "generated", "dataset", "unrelated"]}}}},
    "changed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "impact": {"type": "object", "additionalProperties": false, "required": ["components", "causes"], "properties": {"components": {"type": "array", "uniqueItems": true, "items": {"enum": ["drone", "gc"]}}, "causes": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "propertyNames": {"enum": ["drone", "gc"]}}}}
  },
  "definitions": {
    "entry": {"type": "object", "additionalProperties": false, "required": ["path", "kind", "sha256"], "properties": {"path": {"type": "string"}, "kind": {"enum": ["file", "symlink", "deleted"]}, "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}}},
    "repository": {"type": "object", "additionalProperties": false, "required": ["path", "commit", "state", "content_identity", "tracked_patch_sha256", "entries", "untracked"], "properties": {"path": {"type": "string"}, "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "state": {"enum": ["clean", "modified", "untracked"]}, "content_identity": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "tracked_patch_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "entries": {"type": "array", "items": {"$ref": "#/definitions/entry"}}, "untracked": {"type": "array", "items": {"$ref": "#/definitions/entry"}}}}
  }
}
