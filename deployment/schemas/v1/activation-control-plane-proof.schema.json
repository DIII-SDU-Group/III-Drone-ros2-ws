{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iii-drone.invalid/schemas/v1/activation-control-plane-proof.schema.json",
  "title": "III activation control-plane startup proof",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "proof_id", "release_id", "profile", "started_units", "autonomy_started"],
  "properties": {
    "schema": {"const": "iii.activation-control-plane-proof/v1"},
    "proof_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "release_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "profile": {"type": "string", "pattern": "^[a-z][a-z0-9_.@-]{0,127}$"},
    "started_units": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.@-]{0,127}$"}},
    "autonomy_started": {"const": false}
  }
}
