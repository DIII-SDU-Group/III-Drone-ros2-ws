{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iii-drone.invalid/schemas/v1/portable-state-policy.schema.json",
  "title": "III declared portable-state boundary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "portable_schema_version", "external_archive_warning_days", "domains", "structural_exclusions", "invalidating_mutations"],
  "properties": {
    "schema": {"const": "iii.portable-state-policy/v1"},
    "portable_schema_version": {"const": 1},
    "external_archive_warning_days": {"const": 30},
    "domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/domain"}},
    "structural_exclusions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/relative"}},
    "invalidating_mutations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}}
  },
  "definitions": {
    "relative": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "optional", "exclude"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "path": {"$ref": "#/definitions/relative"},
        "optional": {"type": "boolean"},
        "exclude": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/relative"}}
      }
    }
  }
}
