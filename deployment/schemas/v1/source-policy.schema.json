{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iii-drone.invalid/schemas/v1/source-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "governed_repositories", "workspace_source_roots", "workspace_source_files", "excluded_path_patterns", "component_rules", "non_artifact_patterns"],
  "properties": {
    "schema": {"const": "iii.source-policy/v1"},
    "version": {"const": 1},
    "governed_repositories": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string"}
    },
    "workspace_source_roots": {
      "type": "array", "uniqueItems": true, "items": {"type": "string"}
    },
    "workspace_source_files": {
      "type": "array", "uniqueItems": true, "items": {"type": "string"}
    },
    "excluded_path_patterns": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string"}
    },
    "component_rules": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "patterns", "components"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
          "patterns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "components": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"enum": ["drone", "gc"]}
          }
        }
      }
    },
    "non_artifact_patterns": {
      "type": "array", "uniqueItems": true, "items": {"type": "string"}
    }
  }
}
