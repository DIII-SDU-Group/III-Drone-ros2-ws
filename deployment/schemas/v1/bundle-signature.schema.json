{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iii-drone.invalid/schemas/v1/bundle-signature.schema.json",
  "title": "III detached component bundle signature",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "signature_type", "algorithm", "signer_id", "authority", "release_id", "component", "archive_sha256", "bundle_manifest_sha256", "signature"],
  "properties": {
    "schema_version": {"const": "1"},
    "signature_type": {"const": "iii.bundle-signature"},
    "algorithm": {"const": "Ed25519"},
    "signer_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "authority": {"enum": ["ci-qualified", "workstation-field"]},
    "release_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "component": {"enum": ["drone", "gc"]},
    "archive_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "bundle_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
  }
}
