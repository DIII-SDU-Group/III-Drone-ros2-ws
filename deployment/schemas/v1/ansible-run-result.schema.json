{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iii-drone.local/schemas/v1/ansible-run-result.schema.json",
  "title": "III authenticated Ansible run recap",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "check_mode", "hosts", "totals"],
  "properties": {
    "schema": {"const": "iii.ansible-run-result/v1"},
    "check_mode": {"type": "boolean"},
    "hosts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/definitions/counters"}
    },
    "totals": {"$ref": "#/definitions/counters"}
  },
  "definitions": {
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "changed", "failures", "unreachable", "skipped", "rescued", "ignored"],
      "properties": {
        "ok": {"type": "integer", "minimum": 0},
        "changed": {"type": "integer", "minimum": 0},
        "failures": {"type": "integer", "minimum": 0},
        "unreachable": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "rescued": {"type": "integer", "minimum": 0},
        "ignored": {"type": "integer", "minimum": 0}
      }
    }
  }
}
