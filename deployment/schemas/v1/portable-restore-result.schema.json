{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iii-drone.invalid/schemas/v1/portable-restore-result.schema.json",
  "title": "III atomic portable restore result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "result_id", "operation_id", "backup_id", "generation_path", "selector", "reconciliation", "health", "machine_identity_restored", "receiver_transactions_restored", "verified"],
  "properties": {
    "schema": {"const": "iii.portable-restore-result/v1"},
    "result_id": {"$ref": "#/definitions/hash"},
    "operation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"},
    "backup_id": {"$ref": "#/definitions/hash"},
    "generation_path": {"type": "string", "pattern": "^/"},
    "selector": {"type": "string", "pattern": "^/"},
    "reconciliation": {"type": "object"},
    "health": {"type": "object", "required": ["healthy"], "properties": {"healthy": {"const": true}}},
    "machine_identity_restored": {"const": false},
    "receiver_transactions_restored": {"const": false},
    "verified": {"const": true}
  },
  "definitions": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
