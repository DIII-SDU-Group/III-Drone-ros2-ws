{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iii-drone.invalid/schemas/v1/release-record.schema.json",
  "title": "III auditable qualified-release record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "record_id", "version", "release_id", "source_commit", "workflow", "build_inputs", "checks", "artifacts", "signer_id", "created_at"],
  "properties": {
    "schema_version": {"const": "1"},
    "record_type": {"const": "iii.qualified-release-record"},
    "record_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "version": {"type": "string", "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"},
    "release_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "workflow": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "run_id", "run_attempt", "ref"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "run_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "run_attempt": {"type": "integer", "minimum": 1},
        "ref": {"type": "string", "pattern": "^refs/tags/v.+$"}
      }
    },
    "build_inputs": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/file"}},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/file"}},
    "signer_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "definitions": {
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "sha256", "bytes"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
