{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iii-drone.invalid/schemas/v1/python-wheel-lock.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "python_abi", "platform", "resolver", "requirements_sha256", "wheels", "imports"],
  "properties": {
    "schema": {"const": "iii.python-wheel-lock/v1"},
    "python_abi": {"const": "cp312"},
    "platform": {"const": "manylinux_2_39_aarch64"},
    "resolver": {
      "type": "object", "additionalProperties": false,
      "required": ["reference", "index_digest", "platform", "platform_digest", "pip_version"],
      "properties": {
        "reference": {"const": "docker.io/library/python:3.12.3-slim-bookworm"},
        "index_digest": {"const": "sha256:afc139a0a640942491ec481ad8dda10f2c5b753f5c969393b12480155fe15a63"},
        "platform": {"const": "linux/amd64"},
        "platform_digest": {"const": "sha256:fd3817f3a855f6c2ada16ac9468e5ee93e361005bd226fd5a5ee1a504e038c84"},
        "pip_version": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,2}$"}
      }
    },
    "requirements_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "wheels": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "version", "filename", "sha256", "tags", "requires"],
        "properties": {
          "name": {"type": "string"}, "version": {"type": "string"},
          "filename": {"type": "string", "pattern": "^[^/]+\\.whl$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "requires": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "imports": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
    }
  }
}
