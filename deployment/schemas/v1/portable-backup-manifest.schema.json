{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iii-drone.invalid/schemas/v1/portable-backup-manifest.schema.json",
  "title": "III coordinated portable backup manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "backup_id", "portable_schema_version", "policy_id", "sealed_at", "target", "release_id", "state_marker", "target_state_hash", "domains", "structural_exclusions", "invalidating_mutations", "quiescence", "source"],
  "properties": {
    "schema": {"const": "iii.portable-backup-manifest/v1"},
    "backup_id": {"$ref": "#/definitions/hash"},
    "portable_schema_version": {"const": 1},
    "policy_id": {"$ref": "#/definitions/hash"},
    "sealed_at": {"type": "string", "format": "date-time"},
    "target": {"type": "object", "additionalProperties": false, "required": ["logical_id", "profile"], "properties": {"logical_id": {"type": "string", "minLength": 1}, "profile": {"enum": ["real", "opti_track", "sim", "hil"]}}},
    "release_id": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/hash"}]},
    "state_marker": {"$ref": "#/definitions/hash"},
    "target_state_hash": {"$ref": "#/definitions/hash"},
    "domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/domain"}},
    "structural_exclusions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "invalidating_mutations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "quiescence": {"type": "object", "required": ["writers_stopped"], "properties": {"writers_stopped": {"const": true}}},
    "source": {"enum": ["receiver", "salvage"]}
  },
  "definitions": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/definitions/hash"}}},
    "domain": {"type": "object", "additionalProperties": false, "required": ["name", "source_path", "present", "optional", "files", "domain_hash"], "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}, "source_path": {"type": "string", "minLength": 1}, "present": {"type": "boolean"}, "optional": {"type": "boolean"}, "files": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/file"}}, "domain_hash": {"$ref": "#/definitions/hash"}}}
  }
}
