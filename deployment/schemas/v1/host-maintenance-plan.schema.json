{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iii-drone.invalid/schemas/v1/host-maintenance-plan.schema.json",
  "title": "III host-maintenance plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "maintenance_id", "operation_id", "client_id", "request", "before", "installed_policy_id", "playbook_sha256", "executor_sha256", "expected_package_changes", "trust_change", "mutations", "required_checks", "declared_permissions", "reboot_expected", "no_change"],
  "properties": {
    "schema": {"const": "iii.host-maintenance-plan/v1"},
    "maintenance_id": {"$ref": "#/definitions/hash"},
    "operation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"},
    "client_id": {"$ref": "#/definitions/hash"},
    "request": {"type": "object"},
    "before": {"type": "object"},
    "installed_policy_id": {"$ref": "#/definitions/hash"},
    "playbook_sha256": {"$ref": "#/definitions/hash"},
    "executor_sha256": {"$ref": "#/definitions/hash"},
    "expected_package_changes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.+-]*$"}},
    "trust_change": {"anyOf": [{"type": "null"}, {"type": "object"}]},
    "mutations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "required_checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "declared_permissions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "reboot_expected": {"type": "boolean"},
    "no_change": {"type": "boolean"}
  },
  "definitions": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
