{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iii-drone.invalid/schemas/v1/qualification-attempt.schema.json",
  "title": "III immutable qualification attempt result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attempt_type", "attempt_id", "version", "source_commit", "tag_ref", "outcome", "recorded_at", "failure_stage", "findings", "log_sha256"],
  "properties": {
    "schema_version": {"const": "1"},
    "attempt_type": {"const": "iii.qualification-attempt"},
    "attempt_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "version": {"type": "string", "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"},
    "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "tag_ref": {"type": "string", "pattern": "^refs/tags/v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"},
    "outcome": {"const": "failed"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "failure_stage": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "findings": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "detail"], "properties": {"id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}, "detail": {"type": "string", "minLength": 1}}}},
    "log_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
