{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iii-drone.invalid/schemas/v1/host-maintenance-request.schema.json",
  "title": "III host-maintenance request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "kind", "policy", "offline", "backup", "trust_store", "release_status_index", "retire_signer_ids", "replacement_proofs"],
  "properties": {
    "schema": {"const": "iii.host-maintenance-request/v1"},
    "request_id": {"$ref": "#/definitions/hash"},
    "kind": {"enum": ["packages", "bundle-trust", "release-status-trust"]},
    "policy": {"type": "object"},
    "offline": {"type": "boolean"},
    "backup": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "backup_id", "target_state_hash", "verified", "record_sha256"],
          "properties": {
            "schema": {"const": "iii.host-backup-receipt/v1"},
            "backup_id": {"$ref": "#/definitions/hash"},
            "target_state_hash": {"$ref": "#/definitions/hash"},
            "verified": {"const": true},
            "record_sha256": {"$ref": "#/definitions/hash"}
          }
        }
      ]
    },
    "trust_store": {"anyOf": [{"type": "null"}, {"type": "object"}]},
    "release_status_index": {"anyOf": [{"type": "null"}, {"type": "object"}]},
    "retire_signer_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/hash"}},
    "replacement_proofs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signer_id", "proof"],
        "properties": {
          "signer_id": {"$ref": "#/definitions/hash"},
          "proof": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
        }
      }
    }
  },
  "definitions": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
