{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iii-drone.invalid/schemas/v1/gc-host-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "supported_platforms", "operational_packages", "development_packages", "forbidden_proxy_host_packages", "managed_user_paths", "login_units", "manual_units", "automatic_hostname", "clock_profiles", "clock_skip_profiles", "builder", "offline_roles", "excluded_prerequisites"],
  "properties": {
    "schema": {"const": "iii.gc-host-policy/v1"},
    "supported_platforms": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["id", "os_id", "version_id", "architecture"], "properties": {"id": {"type": "string", "minLength": 1}, "os_id": {"const": "ubuntu"}, "version_id": {"enum": ["22.04", "24.04"]}, "architecture": {"const": "x86_64"}}}},
    "operational_packages": {"$ref": "#/definitions/strings"},
    "development_packages": {"$ref": "#/definitions/strings"},
    "forbidden_proxy_host_packages": {"$ref": "#/definitions/strings"},
    "managed_user_paths": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "mode", "class"], "properties": {"path": {"type": "string", "pattern": "^[.][A-Za-z0-9._/-]+$"}, "mode": {"pattern": "^0[0-7]{3}$"}, "class": {"enum": ["application", "cache", "logs", "machine-identity", "portable-records", "secret", "settings", "state"]}}}},
    "login_units": {"$ref": "#/definitions/units"},
    "manual_units": {"$ref": "#/definitions/units"},
    "automatic_hostname": {"const": "iii.local"},
    "clock_profiles": {"const": ["real"]},
    "clock_skip_profiles": {"const": ["sim"]},
    "builder": {"type": "object", "additionalProperties": false, "required": ["target", "tag", "definition", "definition_sha256"], "properties": {"target": {"const": "cross-compiler"}, "tag": {"type": "string", "minLength": 1}, "definition": {"const": "Dockerfile.cc"}, "definition_sha256": {"$ref": "#/definitions/hash"}}},
    "offline_roles": {"$ref": "#/definitions/strings"},
    "excluded_prerequisites": {"$ref": "#/definitions/strings"}
  },
  "definitions": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "units": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9@.-]+[.]service$"}}
  }
}
