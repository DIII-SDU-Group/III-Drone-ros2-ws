{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iii-drone.invalid/schemas/v1/field-warning-acknowledgement.schema.json",
  "title": "III signed field warning acknowledgement",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "acknowledgement_id", "readiness_record_id", "recorded_at", "warning_ids", "rationale", "severity_changed", "authorization", "signer_authority", "signature"],
  "properties": {
    "schema": {"const": "iii.field-warning-acknowledgement/v1"},
    "acknowledgement_id": {"$ref": "#/definitions/hash"},
    "readiness_record_id": {"$ref": "#/definitions/hash"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "warning_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^FIELD\\.[A-Z0-9_.]+$"}},
    "rationale": {"type": "string", "minLength": 1},
    "severity_changed": {"const": false},
    "authorization": {"const": false},
    "signer_authority": {"const": "workstation-field"},
    "signature": {"type": "object", "additionalProperties": false, "required": ["algorithm", "signer_id", "value"], "properties": {"algorithm": {"const": "Ed25519"}, "signer_id": {"$ref": "#/definitions/hash"}, "value": {"type": "string", "minLength": 1}}}
  },
  "definitions": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
