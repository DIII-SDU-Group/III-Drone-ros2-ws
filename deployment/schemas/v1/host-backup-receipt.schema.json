{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iii-drone.invalid/schemas/v1/host-backup-receipt.schema.json",
  "title": "III verified portable host backup receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "backup_id", "receipt_id", "sealed_at", "verified_at", "verified", "external_verified", "fresh", "target", "release_id", "state_marker", "target_state_hash", "archive_sha256", "archive_bytes", "policy_id", "source", "operation_id", "protected", "references"],
  "properties": {
    "schema": {"const": "iii.host-backup-receipt/v1"},
    "backup_id": {"$ref": "#/definitions/hash"},
    "receipt_id": {"$ref": "#/definitions/hash"},
    "sealed_at": {"type": "string", "format": "date-time"},
    "verified_at": {"type": "string", "format": "date-time"},
    "verified": {"const": true},
    "external_verified": {"type": "boolean"},
    "fresh": {"type": "boolean"},
    "target": {"type": "object", "additionalProperties": false, "required": ["logical_id", "profile"], "properties": {"logical_id": {"type": "string", "minLength": 1}, "profile": {"enum": ["real", "opti_track", "sim"]}}},
    "release_id": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/hash"}]},
    "state_marker": {"$ref": "#/definitions/hash"},
    "target_state_hash": {"$ref": "#/definitions/hash"},
    "archive_sha256": {"$ref": "#/definitions/hash"},
    "archive_bytes": {"type": "integer", "minimum": 1},
    "policy_id": {"$ref": "#/definitions/hash"},
    "source": {"enum": ["receiver", "salvage"]},
    "operation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"},
    "protected": {"const": true},
    "references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/hash"}}
  },
  "definitions": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
