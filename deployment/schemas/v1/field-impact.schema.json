{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iii-drone.invalid/schemas/v1/field-impact.schema.json",
  "title": "III field deployment source impact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "impact_id", "source_identity", "components", "component_reasons", "groups", "detail", "missions", "px4_write_planned", "ordering", "resulting_identities"],
  "properties": {
    "schema": {"const": "iii.field-impact/v1"},
    "impact_id": {"$ref": "#/definitions/hash"},
    "source_identity": {"$ref": "#/definitions/hash"},
    "components": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["drone", "gc"]}},
    "component_reasons": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}},
    "groups": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missions", "behavior_trees", "parameters", "px4_manifest_drift"],
      "properties": {
        "missions": {"$ref": "#/definitions/paths"},
        "behavior_trees": {"$ref": "#/definitions/paths"},
        "parameters": {"$ref": "#/definitions/paths"},
        "px4_manifest_drift": {"$ref": "#/definitions/paths"}
      }
    },
    "detail": {"type": "object", "required": ["missions", "parameters", "detail_id"]},
    "missions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inferred", "included", "excluded", "selected"],
      "properties": {
        "inferred": {"$ref": "#/definitions/names"},
        "included": {"$ref": "#/definitions/names"},
        "excluded": {"$ref": "#/definitions/names"},
        "selected": {"$ref": "#/definitions/names"}
      }
    },
    "px4_write_planned": {"const": false},
    "ordering": {"type": "array", "uniqueItems": true, "items": {"enum": ["gc", "drone"]}},
    "resulting_identities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mission_catalog", "configuration", "component_source"],
      "properties": {
        "mission_catalog": {"$ref": "#/definitions/hash"},
        "configuration": {"$ref": "#/definitions/hash"},
        "component_source": {"$ref": "#/definitions/hash"}
      }
    }
  },
  "definitions": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
