{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iii-drone.invalid/schemas/v1/release-metadata.schema.json",
  "title": "III version-independent qualified release metadata inputs",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "component_targets", "compatibility", "configuration", "px4", "qgc", "profiles", "mission_catalog", "operator", "input_paths"],
  "properties": {
    "schema": {"const": "iii.release-metadata/v1"},
    "component_targets": {
      "type": "object", "additionalProperties": false, "required": ["drone", "gc"],
      "properties": {
        "drone": {"$ref": "#/definitions/target"},
        "gc": {"$ref": "#/definitions/target"}
      }
    },
    "compatibility": {
      "type": "object", "additionalProperties": false, "required": ["api_ranges", "schema_ranges"],
      "properties": {
        "api_ranges": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "schema_ranges": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}
      }
    },
    "configuration": {
      "type": "object", "additionalProperties": false, "required": ["schema_version", "compatible_from", "capture_contract"],
      "properties": {
        "schema_version": {"type": "integer", "minimum": 1},
        "compatible_from": {"type": "array", "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
        "capture_contract": {"const": "iii.capture/v1"}
      }
    },
    "px4": {
      "type": "object", "additionalProperties": false, "required": ["firmware_range", "firmware_version", "firmware_commit"],
      "properties": {
        "firmware_range": {"type": "string", "minLength": 1},
        "firmware_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "firmware_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "qgc": {
      "type": "object", "additionalProperties": false, "required": ["compatible_versions"],
      "properties": {"compatible_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
    },
    "profiles": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "bootable", "parameter_profile", "capabilities", "default_mission", "health"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "status": {"enum": ["commissioned", "not_commissioned"]},
          "bootable": {"type": "boolean"},
          "parameter_profile": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"}},
          "default_mission": {"type": "string", "minLength": 1},
          "health": {"$ref": "#/definitions/health"}
        }
      }
    },
    "mission_catalog": {
      "type": "object", "additionalProperties": false, "required": ["schema_version"],
      "properties": {"schema_version": {"type": "integer", "minimum": 1}}
    },
    "operator": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_downtime_s", "pre_deploy_commands", "post_deploy_commands"],
      "properties": {
        "expected_downtime_s": {"type": "integer", "minimum": 0},
        "pre_deploy_commands": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}},
        "post_deploy_commands": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
      }
    },
    "input_paths": {
      "type": "object", "additionalProperties": false,
      "required": ["configuration", "px4_real", "px4_sim", "px4_reference", "px4_network", "px4_interface", "px4_firmware", "px4_dds_topics", "qgc_managed_settings"],
      "properties": {
        "configuration": {"$ref": "#/definitions/paths"},
        "px4_real": {"$ref": "#/definitions/paths"},
        "px4_sim": {"$ref": "#/definitions/paths"},
        "px4_reference": {"$ref": "#/definitions/paths"},
        "px4_network": {"$ref": "#/definitions/paths"},
        "px4_interface": {"$ref": "#/definitions/paths"},
        "px4_firmware": {"$ref": "#/definitions/paths"},
        "px4_dds_topics": {"$ref": "#/definitions/paths"},
        "qgc_managed_settings": {"$ref": "#/definitions/paths"}
      }
    }
  },
  "definitions": {
    "health": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "required_hardware_roles", "optional_hardware_roles", "required_services", "optional_services", "required_managed_nodes", "optional_managed_nodes", "required_systemd_units"],
      "properties": {
        "schema": {"const": "iii.activation-health-policy/v1"},
        "required_hardware_roles": {"$ref": "#/definitions/entity_list"},
        "optional_hardware_roles": {"$ref": "#/definitions/entity_list"},
        "required_services": {"$ref": "#/definitions/entity_list"},
        "optional_services": {"$ref": "#/definitions/entity_list"},
        "required_managed_nodes": {"$ref": "#/definitions/lifecycle_map"},
        "optional_managed_nodes": {"$ref": "#/definitions/lifecycle_map"},
        "required_systemd_units": {"$ref": "#/definitions/entity_list"}
      }
    },
    "entity_list": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.@-]{0,127}$"}},
    "lifecycle_map": {"type": "object", "additionalProperties": {"enum": ["unconfigured", "inactive", "active"]}, "propertyNames": {"pattern": "^[a-z][a-z0-9_.@-]{0,127}$"}},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["target_id", "os", "os_version", "architecture"],
      "properties": {
        "target_id": {"type": "string", "minLength": 1},
        "os": {"const": "ubuntu"},
        "os_version": {"enum": ["22.04", "24.04"]},
        "architecture": {"enum": ["aarch64", "x86_64"]}
      }
    },
    "paths": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
    }
  }
}
