{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iii-drone.invalid/schemas/v1/field-deployment-report.schema.json",
  "title": "III field deployment plan or completion report",
  "type": "object",
  "additionalProperties": false,
  "required": ["display", "impact", "actual"],
  "properties": {
    "display": {"type": "string", "minLength": 1},
    "impact": {"type": "object", "required": ["schema", "impact_id", "components", "groups", "detail", "resulting_identities"]},
    "actual": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["schema", "actual_id", "phases"]}]}
  }
}
