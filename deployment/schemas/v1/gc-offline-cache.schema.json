{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iii-drone.invalid/schemas/v1/gc-offline-cache.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "platform_id", "created_at", "artifacts", "cache_id"],
  "properties": {
    "schema": {"const": "iii.gc-offline-cache/v1"},
    "platform_id": {"enum": ["ubuntu-22.04-x86_64", "ubuntu-24.04-x86_64"]},
    "created_at": {"type": "string", "format": "date-time"},
    "artifacts": {"type": "array", "minItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["role", "path", "sha256", "size"], "properties": {"role": {"type": "string", "minLength": 1}, "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)[.][.]($|/)).+$"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "size": {"type": "integer", "minimum": 1}}}},
    "cache_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
