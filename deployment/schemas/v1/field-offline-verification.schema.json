{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "cache_id": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "network_access": {"const": false},
    "offline": {"const": true},
    "releases": {
      "items": {"type": "object"},
      "minItems": 1,
      "type": "array"
    },
    "scenarios": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "component_contracts": {"minProperties": 1, "type": "object"},
          "components": {
            "items": {"enum": ["drone", "gc"]},
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "network_access": {"const": false},
          "release_id": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
          "scenario": {"enum": ["gc-only", "drone-only", "paired"]},
          "target_mutation": {"const": false},
          "verified": {"const": true},
          "version": {"pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$", "type": "string"}
        },
        "required": ["version", "release_id", "scenario", "components", "component_contracts", "verified", "network_access", "target_mutation"],
        "type": "object"
      },
      "minItems": 3,
      "type": "array"
    },
    "schema": {"const": "iii.field-offline-verification/v1"},
    "target_mutation": {"const": false},
    "verification_id": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  },
  "required": ["schema", "verification_id", "cache_id", "releases", "scenarios", "offline", "network_access", "target_mutation"],
  "title": "III offline field verification",
  "type": "object"
}
