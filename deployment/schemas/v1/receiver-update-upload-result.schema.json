{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iii-drone.invalid/schemas/v1/receiver-update-upload-result.schema.json",
  "title": "III receiver update upload result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receiver_id", "upload_id", "state", "resumed", "files"],
  "properties": {
    "schema": {"const": "iii.receiver-update-upload-result/v1"},
    "receiver_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "upload_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "state": {"enum": ["partial", "complete"]},
    "resumed": {"type": "boolean"},
    "files": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 3,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["size", "sha256"],
        "properties": {
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
