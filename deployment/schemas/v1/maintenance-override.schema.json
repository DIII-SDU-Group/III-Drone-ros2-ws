{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iii-drone.invalid/schemas/v1/maintenance-override.schema.json",
  "title": "Interactive single-operation maintenance override",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "override_id", "operation_id", "actor_id", "release_id", "logical_target", "profile", "observation_id", "stopped_units", "confirmation"],
  "properties": {
    "schema": {"const": "iii.maintenance-override/v1"},
    "override_id": {"$ref": "#/definitions/hash"},
    "operation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"},
    "actor_id": {"$ref": "#/definitions/hash"},
    "release_id": {"$ref": "#/definitions/hash"},
    "logical_target": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$"},
    "profile": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
    "observation_id": {"$ref": "#/definitions/hash"},
    "stopped_units": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "confirmation": {"type": "string", "pattern": "^PHYSICALLY SAFE [a-z][a-z0-9.-]{0,63}$"}
  },
  "definitions": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
