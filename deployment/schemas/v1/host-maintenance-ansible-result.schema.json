{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iii-drone.invalid/schemas/v1/host-maintenance-ansible-result.schema.json",
  "title": "III Ansible host-maintenance result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "policy_id", "packages", "reboot_required"],
  "properties": {
    "schema": {"const": "iii.host-maintenance-ansible-result/v1"},
    "kind": {"enum": ["packages", "bundle-trust", "release-status-trust"]},
    "policy_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "packages": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9.+-]*(?::[a-z0-9]+)?$"},
      "additionalProperties": {
        "type": "array",
        "items": {"type": "object"}
      }
    },
    "reboot_required": {"type": "boolean"}
  }
}
