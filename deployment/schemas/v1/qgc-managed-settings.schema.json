{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iii-drone.invalid/schemas/v1/qgc-managed-settings.schema.json",
  "title": "III QGroundControl managed settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "settings_id", "policy_id", "qgc_versions", "profiles", "settings"],
  "properties": {
    "schema": {"const": "iii.qgc-managed-settings/v1"},
    "settings_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "qgc_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}},
    "profiles": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"enum": ["real", "sim", "hil", "opti_track"]}},
    "settings": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": ["string", "boolean", "number"]},
      "propertyNames": {"pattern": "^[^/]+/.+$"}
    }
  }
}
