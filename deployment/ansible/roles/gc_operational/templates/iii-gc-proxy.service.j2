[Unit]
Description=III ROS-free ground-control proxy container
PartOf=iii-gc.target graphical-session.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile={{ iii_gc_home }}/.config/iii/gc.env
EnvironmentFile={{ iii_gc_home }}/.config/iii/gc-profile.env
EnvironmentFile=-{{ iii_gc_home }}/.config/iii/ground-control-secrets.env
EnvironmentFile={{ iii_gc_home }}/.local/share/iii/gc-applications/current/application.env
ExecStart=/usr/bin/docker compose --project-name iii-ground-control --file {{ iii_gc_home }}/.local/share/iii/gc-applications/current/payload/compose.yml up --no-build proxy
ExecStop=/usr/bin/docker compose --project-name iii-ground-control --file {{ iii_gc_home }}/.local/share/iii/gc-applications/current/payload/compose.yml stop --timeout 10 proxy
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=iii-gc.target
