[Unit]
Description=III real-aircraft clock synchronization companion
PartOf=iii-gc.target graphical-session.target
After=iii-gc-discovery.service

[Service]
Type=simple
EnvironmentFile={{ iii_gc_home }}/.config/iii/gc.env
ExecStart={{ iii_gc_home }}/.local/share/iii/gc-runtime/venv/bin/iii-gc-companion --role clock
Restart=on-failure
RestartSec=3

[Install]
WantedBy=iii-gc.target
