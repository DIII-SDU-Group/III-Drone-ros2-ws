#!/usr/sbin/nft -f
flush ruleset

table inet iii_filter {
  chain input {
    type filter hook input priority filter; policy drop;
    ct state invalid drop
    ct state established,related accept
    iifname "lo" accept
    ip protocol icmp accept
    ip6 nexthdr ipv6-icmp accept
    ip saddr {{ iii_provisioning_inputs.operator_cidr }} tcp dport 22 accept comment "receiver, maintenance, and bootstrap SSH"
    ip saddr {{ iii_provisioning_inputs.operator_cidr }} tcp dport {{ iii_runtime_api_port }} accept comment "plain HTTP and WebSocket runtime API"
    ip saddr {{ iii_provisioning_inputs.operator_cidr }} udp dport {{ iii_mdns_port }} accept comment "mDNS"
    ip saddr {{ iii_px4_subnet }} udp dport {{ iii_px4_mavlink_udp_port }} accept comment "PX4 MAVLink from flight controller Ethernet"
    ip saddr {{ iii_px4_subnet }} udp dport {{ iii_px4_mavlink_audit_udp_port }} accept comment "PX4 read-only release audit"
    ip saddr {{ iii_px4_subnet }} udp dport {{ iii_px4_uxrce_dds_udp_port }} accept comment "PX4 uXRCE-DDS from flight controller Ethernet"
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
  }

  chain output {
    type filter hook output priority filter; policy accept;
  }
}
