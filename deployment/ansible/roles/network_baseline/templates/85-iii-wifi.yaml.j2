# Managed by `iii host provision`: the active Wi-Fi client, or a profile's
# stored client under /etc/iii/wifi (real and opti_track keep one each).
# Holds the Wi-Fi secret: root-only, kept on the Pi, never copied back.
network:
  version: 2
  wifis:
    {{ iii_wifi_interface }}:
      optional: true
      dhcp4: true
      dhcp4-overrides:
        route-metric: {{ iii_wifi_route_metric | int }}
{% if iii_wifi_regulatory_domain %}
      regulatory-domain: {{ iii_wifi_regulatory_domain | to_json }}
{% endif %}
      access-points:
        {{ iii_wifi_ssid | to_json }}:
          password: {{ iii_wifi_psk | to_json }}
