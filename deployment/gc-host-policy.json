    {"path": ".local/state/iii/gc", "mode": "0700", "class": "state"},
    {"path": ".local/state/iii/registry", "mode": "0700", "class": "portable-records"},
    {"path": ".local/state/iii/logs", "mode": "0700", "class": "logs"},
    {"path": ".local/share/iii", "mode": "0700", "class": "application"},
    {"path": ".cache/iii", "mode": "0700", "class": "cache"}
