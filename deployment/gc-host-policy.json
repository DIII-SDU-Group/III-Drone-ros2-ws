    "ansible-controller-wheelhouse",
    "gc-runtime-wheelhouse",
    "gc-container-images",
    "arm64-builder-image",
    "apt-packages"
  ],
  "excluded_prerequisites": [
    "disk-partitioning",
    "full-disk-encryption",
