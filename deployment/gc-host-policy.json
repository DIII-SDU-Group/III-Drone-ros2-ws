    {"id": "ubuntu-24.04-x86_64", "os_id": "ubuntu", "version_id": "24.04", "architecture": "x86_64"}
  ],
  "operational_packages": [
    "avahi-utils",
    "ca-certificates",
    "curl",
    "docker.io",
    "docker-compose-v2",
    "libnss-mdns",
    "python3",
    "python3-venv",
    "xdg-utils"
  ],
  "development_packages": [
    "build-essential",
    "git",
    "git-lfs",
