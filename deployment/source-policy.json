{
  "schema": "iii.source-policy/v1",
  "version": 1,
  "governed_repositories": [
    ".",
    "src/III-Drone-Configuration",
    "src/III-Drone-Contracts",
    "src/III-Drone-Core",
    "src/III-Drone-GC",
    "src/III-Drone-Interfaces",
    "src/III-Drone-Mission",
    "src/III-Drone-Runtime",
    "src/III-Drone-Simulation",
    "src/III-Drone-Supervision",
    "src/iwr6843aop-ROS2-pkg",
    "tools/III-Drone-CLI"
  ],
  "workspace_source_roots": [
    ".devcontainer",
    ".github",
    "cc_ws",
    "codex-backlogs",
    "deployment",
    "deps",
    "docs",
    "scripts",
    "setup",
    "tools/systemd"
  ],
  "workspace_source_files": [
    ".dockerignore",
    ".gitmodules",
    "AGENTS.md",
    "CONTEXT-MAP.md",
    "Dockerfile",
    "Dockerfile.cc",
    "Dockerfile.dev",
    "README.md",
    "defaults.yaml",
    "docker-compose.yml",
    "entrypoint_cc.sh",
    "entrypoint_dev.sh",
    "entrypoint_real.sh",
    "iii-dev",
    "requirements.txt",
    "tools.md"
  ],
  "excluded_path_patterns": [
    "**/.env",
    "**/.env.*",
    "**/*secret*",
    "**/*credential*",
    "**/*.key",
    "**/*.pem",
    "**/*.p12",
    "**/*.bag",
    "**/*.db3",
    "**/*.mcap",
    "build/**",
    "install/**",
    "log/**",
    "runtime/**",
    "runtime_logs/**",
    "datasets/**",
    "rosbags/**",
    "**/__pycache__/**",
    "**/.pytest_cache/**",
    "**/node_modules/**"
  ],
  "component_rules": [
    {"id": "GC", "patterns": ["src/III-Drone-GC", "src/III-Drone-GC/**"], "components": ["gc"]},
    {"id": "DRONE", "patterns": ["src/III-Drone-Core", "src/III-Drone-Core/**", "src/III-Drone-Mission", "src/III-Drone-Mission/**", "src/III-Drone-Runtime", "src/III-Drone-Runtime/**", "src/III-Drone-Simulation", "src/III-Drone-Simulation/**", "src/III-Drone-Supervision", "src/III-Drone-Supervision/**", "src/iwr6843aop-ROS2-pkg", "src/iwr6843aop-ROS2-pkg/**"], "components": ["drone"]},
    {"id": "SHARED_CONTRACT", "patterns": ["src/III-Drone-Configuration", "src/III-Drone-Configuration/**", "src/III-Drone-Contracts", "src/III-Drone-Contracts/**", "src/III-Drone-Interfaces", "src/III-Drone-Interfaces/**", "tools/III-Drone-CLI", "tools/III-Drone-CLI/**"], "components": ["drone", "gc"]},
    {"id": "WORKSPACE_INTEGRATION", "patterns": [".dockerignore", ".github/**", "deployment/**", "cc_ws/**", "setup/**", "scripts/**", "Dockerfile*", "entrypoint_*.sh", "requirements.txt", "deps/submodule-lock.txt"], "components": ["drone", "gc"]}
  ],
  "non_artifact_patterns": ["docs/**", "codex-backlogs/**", "README.md", "AGENTS.md", "CONTEXT-MAP.md"]
}
