# PX4 parameter baseline: opti_track (OptiTrack flight lab)
#
# Ethernet transport on the aircraft ports, a vision-only estimator (no GPS,
# no magnetometer indoors) and the lab failsafes with a safety pilot on RC.
#
# Pi PX4-facing interface: 10.41.10.1
# PX4 Ethernet endpoint:   10.41.10.2
#
# Not part of this baseline: the geofence (GF_MAX_HOR_DIST, GF_MAX_VER_DIST,
# GF_ACTION), which is set from the measured cage, and MPC_THR_HOVER, which is
# measured from a steady hover for each payload configuration.
#
# This is a QGroundControl parameter file (tab-separated; TYPE 6 = INT32,
# 9 = REAL32), so QGroundControl can also load it. Lines starting with # are
# comments. `iii px4 param-baseline --profile opti_track` applies it, and the Pi
# checks the flight controller against it before every system boot and start.
#
# MAV ID	COMPONENT ID	PARAM NAME	VALUE	TYPE

# uXRCE-DDS client over Ethernet (UXRCE_DDS_CFG 1000 = Ethernet) to the Pi's
# Micro XRCE-DDS agent: 10.41.10.1 as the int32 PX4 expects, UDP 8888.
1	1	UXRCE_DDS_CFG	1000	6
1	1	UXRCE_DDS_AG_IP	170461697	6
1	1	UXRCE_DDS_PRT	8888	6

# Must equal the stack ROS domain provisioned on the Pi (iii_ros_domain_id,
# ROS_DOMAIN_ID in /etc/iii/runtime.env). The applier and the boot check
# use the Pi's provisioned domain in place of this value.
1	1	UXRCE_DDS_DOM_ID	42	6

# No agent time sync, as qualified in HIL.
1	1	UXRCE_DDS_SYNCT	0	6

# MAVLink instance 2 over Ethernet, broadcasting to the Pi on UDP 14540. The
# telemetry radio's MAVLink instance, used by QGroundControl, is left untouched.
1	1	MAV_2_CONFIG	1000	6
1	1	MAV_2_UDP_PRT	14540	6
1	1	MAV_2_REMOTE_PRT	14540	6
1	1	MAV_2_BROADCAST	1	6

# EKF2 positions from OptiTrack external vision; the barometer is the height
# backup. EKF2_EV_CTRL bits: 0 horizontal position, 1 vertical position, 3 yaw
# (= 11). EKF2_HGT_REF 3 = Vision. EKF2_MAG_TYPE 5 = None.
1	1	EKF2_EV_CTRL	11	6
1	1	EKF2_HGT_REF	3	6
1	1	EKF2_GPS_CTRL	0	6
1	1	EKF2_BARO_CTRL	1	6
1	1	EKF2_MAG_TYPE	5	6
1	1	SYS_HAS_MAG	0	6
1	1	SYS_HAS_GPS	0	6

# Noise mode 0: the relay's reported variances, lower-bounded by EKF2_EVP_NOISE
# (m) and EKF2_EVA_NOISE (rad; 0.05 is its minimum).
1	1	EKF2_EV_NOISE_MD	0	6
1	1	EKF2_EVP_NOISE	0.05	9
1	1	EKF2_EVA_NOISE	0.05	9
1	1	EKF2_EV_QMIN	0	6

# Initial estimate (ms) of the Motive capture to PX4 arrival latency through the
# lab gateway, Wi-Fi, the relay and Ethernet. The pose relay sends timestamp 0,
# so PX4 stamps each vision sample on arrival. Tune it from flight logs.
1	1	EKF2_EV_DELAY	30.0	9

# Maximum dead-reckoning time without vision, in microseconds (1 s).
1	1	EKF2_NOAID_TOUT	1000000	6

# Lab failsafes. NAV_RCL_ACT 3 = Land on RC loss; COM_POSCTL_NAVL 0 = Altitude
# mode on position loss in Position mode; COM_POS_FS_EPH in m (PX4 invalidates
# position at 2.5x this value); MIS_TAKEOFF_ALT in m; COM_LOW_BAT_ACT 2 = Land;
# BAT1_N_CELLS 6 = 6S.
1	1	NAV_RCL_ACT	3	6
1	1	COM_POSCTL_NAVL	0	6
1	1	COM_POS_FS_EPH	1.0	9
1	1	MIS_TAKEOFF_ALT	1.2	9
1	1	COM_LOW_BAT_ACT	2	6
1	1	BAT1_N_CELLS	6	6
