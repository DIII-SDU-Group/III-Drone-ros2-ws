{
  "schema": "iii.branch-policy/v1",
  "workspace": {
    "develop": {"sources": ["feature"], "required_checks": ["promotion-source", "dependency-governance", "iii-tests"]},
    "main": {"sources": ["promote/develop-to-main/*"], "required_checks": ["promotion-source", "promotion-evidence", "dependency-governance", "iii-tests"]},
    "release": {"sources": ["main"], "required_checks": ["promotion-source", "promotion-evidence", "dependency-governance", "qualified-preflight"]}
  },
  "submodule": {
    "develop": {"sources": ["feature"], "required_checks": ["promotion-source", "iii-tests"]},
    "main": {"sources": ["promote/develop-to-main/*"], "required_checks": ["promotion-source", "iii-tests"]}
  },
  "protected_branches": ["develop", "main", "release"],
  "mechanical_workspace_paths": ["deps/submodule-lock.txt", "src/III-*", "tools/III-*"],
  "review": {"required_approvals": 0, "require_pull_request": true, "require_conversation_resolution": true},
  "history": {"allow_deletion": false, "allow_force_push": false}
}

