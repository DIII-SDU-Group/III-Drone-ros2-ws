[Unit]
Description=III real-profile system daemon
Wants=iii-deployment-receiver.service
After=local-fs.target network-online.target iii-deployment-receiver.service
Wants=network-online.target
PartOf=iii.target
ConditionPathExists=/var/lib/iii/deployment/active-selector.json
ConditionPathIsSymbolicLink=/opt/iii/current
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=iii
Group=iii
UMask=0027
WorkingDirectory=/var/lib/iii
EnvironmentFile=/etc/iii/runtime.env
Environment=III_CLOCK_FLUSH_COMMIT_PATH=/run/iii/clock-flush/system-daemon.json
ExecStartPre=/usr/libexec/iii/iii-release-launch system-daemon --verify
ExecStart=/usr/libexec/iii/iii-release-launch system-daemon
Restart=on-failure
RestartSec=2s
TimeoutStopSec=20s
KillMode=control-group
StandardOutput=null
StandardError=null
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/iii /var/lib/iii/configuration /var/lib/iii/tuning /var/log/iii
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
