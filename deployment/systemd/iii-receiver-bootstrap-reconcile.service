[Unit]
Description=III stable receiver A/B recovery bootstrap
After=local-fs.target
Before=iii-deployment-receiver-reconcile.service iii-deployment-receiver.service
ConditionPathExists=/var/lib/iii/deployment/receiver-update.json

[Service]
Type=oneshot
ExecStart=/opt/iii/receiver/bootstrap/bin/iii-receiver-bootstrap --reconcile
User=root
Group=root
UMask=0027
NoNewPrivileges=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/iii/receiver/selectors /var/lib/iii/deployment /run/iii
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
