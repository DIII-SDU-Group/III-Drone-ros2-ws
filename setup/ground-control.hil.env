# Workstation GC for the split-host HIL runtime. Sim/field GC has a separate
# Compose project and ports; selecting another profile fails identity checks.
III_GC_EXPECTED_RUNTIME_ID=iii-runtime
III_GC_EXPECTED_SYSTEM_ID=iii-drone
III_GC_EXPECTED_PROFILE=hil
III_GC_COMPOSE_PROJECT=iii-ground-control-hil
III_GC_IMAGE_TAG=hil
III_GC_PROXY_PORT=8781
III_GC_FRONTEND_PORT=5174
III_GC_PROXY_PUBLIC_URL=http://127.0.0.1:8781
III_GC_PROXY_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
