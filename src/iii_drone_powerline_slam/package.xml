<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>iii_drone_powerline_slam</name>
  <version>0.1.0</version>
  <description>Lifecycle-managed powerline SLAM perception backend (simulation profile): runs the pinned powerline_slam r26 development estimator on III-native sensor inputs and publishes a passive iii_drone_interfaces/Powerline output under its own namespace.</description>
  <maintainer email="ffn@sdu.dk">Frederik Falk Nyboe</maintainer>
  <license>Proprietary</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>iii_drone_interfaces</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
